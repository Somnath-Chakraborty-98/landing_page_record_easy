BASE_URL=http://localhost:4000
PORT=4000

# SMTP Configuration (Zoho Mail for custom domain)
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASS=your_zoho_password_here
SMTP_FROM_EMAIL=your-email@yourdomain.com
SMTP_FROM_NAME=RecordEasy (by YourCompany)

# Database (PostgreSQL - use Supabase for production)
DATABASE_URL="postgresql://user:password@host:5432/recordeasy"

# Razorpay (for donations/payments)
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
DONATION_MIN_AMOUNT_INR=99
DONATION_MAX_AMOUNT_INR=100000

# Support
SUPPORT_EMAIL=support@yourdomain.com
